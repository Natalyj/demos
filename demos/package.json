{
  "name": "demos",
  "type": "module",
  "sideEffects": false,
  "scripts": {
    "build": "rm -rf ./dist && node build/esbuild.config.build.js",
    "watch": "rm -rf ./dist && node build/esbuild.config.watch.js",
    "lint": "eslint",
    "lint:fix": "eslint --fix",
    "fsd": "steiger ./src"
  },
  "packageManager": "yarn@4.18.1",
  "engines": {
    "node": "26.9.0"
  },
  "imports": {
    "#entities/*": "./src/entities/*/index.ts",
    "#pages/*": "./src/pages/*/index.ts",
    "#widgets/*": "./src/widgets/*/index.ts",
    "#shared/*": "./src/shared/*/index.ts"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "jotai": "^3.0.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@craftamap/esbuild-plugin-html": "^0.9.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript-eslint/eslint-plugin": "^8.71.2",
    "@typescript-eslint/parser": "^8.71.2",
    "esbuild": "^0.28.2",
    "esbuild-plugin-polyfill-node": "^0.3.0",
    "eslint": "^10.13.0",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-prettier": "^5.5.7",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "prettier": "^3.9.10",
    "prettier-plugin-organize-imports": "^4.3.0",
    "steiger": "^0.7.0",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.71.2"
  }
}
